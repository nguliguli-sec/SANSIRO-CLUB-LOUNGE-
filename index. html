<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club Lounge</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <h1>🍹 Club Lounge</h1>
        <nav>
            <ul>
                <li><a href="#menu">Menu</a></li>
                <li><a href="#shisha">Shisha</a></li>
                <li><a href="#drinks">Drinks</a></li>
                <li><a href="#food">Food</a></li>
                <li><a href="#news">News</a></li>
            </ul>
        </nav>
    </header>

    <section id="menu">
        <h2>Menu</h2>
        <p>All your favorite drinks, shisha, and foods!</p>
    </section>

    <section id="shisha">
        <h2>Shisha</h2>
        <ul>
            <li>Apple Flavor</li>
            <li>Mango Flavor</li>
            <li>Mint</li>
        </ul>
    </section>

    <section id="drinks">
        <h2>Drinks</h2>
        <ul>
            <li>Bia (Beer)</li>
            <li>Soda</li>
            <li>Cocktails</li>
        </ul>
    </section>

    <section id="food">
        <h2>Food</h2>
        <ul>
            <li>Pizza</li>
            <li>Burger</li>
            <li>Fries</li>
        </ul>
    </section>

    <section id="news">
        <h2>News & Announcements</h2>
        <div id="news-container">
            <!-- Dynamic news / ads will appear here -->
        </div>
        <button id="notify-btn">Notify Me</button>
    </section>

    <footer>
        <p>© 2026 Club Lounge</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
