body {
    font-family: Arial, sans-serif;
    margin:0; padding:0;
    background: #111;
    color: #fff;
}

header {
    background: #222;
    padding: 20px;
    text-align: center;
}

header h1 {
    margin:0;
    color: #ff9800;
}

nav ul {
    list-style: none;
    padding:0;
    display: flex;
    justify-content: center;
    gap: 15px;
}

nav a {
    color: #fff;
    text-decoration: none;
    font-weight: bold;
}

section {
    padding: 20px;
    border-bottom: 1px solid #444;
}

button {
    padding: 10px 20px;
    background: #ff9800;
    border: none;
    color: #111;
    cursor: pointer;
    font-weight: bold;
    border-radius: 5px;
}
